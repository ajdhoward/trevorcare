# Environment variables for local development and Cloudflare deployment.
# Copy to .env (never committed) and change every value before real use.

# ---- portal gate (server) -----------------------------------------------
# The password for the /login screen. If unset, the demo fallback
# "demo-password" is used and the login page says so on screen.
PORTAL_PASSWORD=demo-password

# Secret that signs the 30-day session cookie. Rotate it to sign everyone out.
SESSION_SECRET=change-me-rotate-for-production

# Force Secure cookie attribute even in dev (set to 1 when serving over HTTPS
# or from an embedded preview pane).
# PORTAL_COOKIE_SECURE=1

# ---- database (Prisma/SQLite) -------------------------------------------
DATABASE_URL="file:./db/custom.db"
