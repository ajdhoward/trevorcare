# Environment variables for local development and Cloudflare deployment.
# Copy to .env (never committed) and change every value before real use.

# ---- portal gate (server) -----------------------------------------------
# The password for the /login screen. If unset, a built-in demo fallback is
# used and the login page says so on screen.
# Local dev: set the real value in .env (never committed).
# Cloudflare: wrangler secret put PORTAL_PASSWORD
PORTAL_PASSWORD=

# Secret that signs the 30-day session cookie. Rotating it signs everyone out.
# Generate a strong one with: openssl rand -base64 32
# Cloudflare: wrangler secret put SESSION_SECRET
SESSION_SECRET=

# Force Secure cookie attribute even in dev (set to 1 when serving over HTTPS
# or from an embedded preview pane).
# PORTAL_COOKIE_SECURE=1

# Optional per-person accounts: "name:password" pairs, comma separated.
# When set, the username box on /login must match one of these accounts and
# use that account's password. When unset, any memorable username is accepted
# with the shared portal password (recorded in the sign-in audit trail).
# PORTAL_USERS="alex:<their-password>,pat:<their-password>"

# ---- PIM integrations (Google / Apple / Microsoft) -----------------------
# Native calendar/contacts sync activates when these are set as deployment
# secrets. Redirect URIs: <origin>/api/integrations/oauth/callback/<provider>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# ---- database (Prisma/SQLite) -------------------------------------------
DATABASE_URL="file:./db/custom.db"
